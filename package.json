{
  "name": "pi-repl",
  "version": "0.6.0",
  "description": "Collaborative tmux-backed REPL sessions for pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omaclaren/pi-repl.git"
  },
  "bugs": {
    "url": "https://github.com/omaclaren/pi-repl/issues"
  },
  "homepage": "https://github.com/omaclaren/pi-repl#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "repl",
    "tmux",
    "python",
    "ipython",
    "julia",
    "r",
    "haskell",
    "ghci",
    "clojure",
    "ruby",
    "irb",
    "java",
    "jshell",
    "octave",
    "matlab"
  ],
  "files": [
    "index.ts",
    "shared",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "shared-julia-repl.png"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.js",
    "test:integration": "node --import tsx --test test/repl-integration.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "tsx": "^4.23.13",
    "typebox": "^1.3.7",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1"
  }
}
